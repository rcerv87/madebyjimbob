# Render gives you DATABASE_URL. For local imports, use the database's *External* URL and PGSSL=true.
DATABASE_URL=postgres://user:pass@host:5432/madebyjimbob
PGSSL=true

# Cloudflare: Account ID (dashboard sidebar), API token with "Stream: Edit",
# and the customer code from any Stream video URL: customer-<CODE>.cloudflarestream.com
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_STREAM_CUSTOMER_CODE=

# Comma-separated words masked in chat
BANNED_WORDS=
