# Render gives you DATABASE_URL. For local imports, use the database's *External* URL and PGSSL=true.
DATABASE_URL=postgres://user:pass@host:5432/madebyjimbob
PGSSL=true

# Cloudflare: Account ID (dashboard sidebar), API token with "Stream: Edit",
# and the customer code from any Stream video URL: customer-<CODE>.cloudflarestream.com
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_STREAM_CUSTOMER_CODE=

# Comma-separated words masked in chat
BANNED_WORDS=

# Comma-separated emails that can open Studio (and watch every tier), once that email is verified.
# Only these emails can also sign up with reserved names such as jimbob.
ADMIN_EMAILS=

# Signs session cookies. Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# off = skip the "was this password in a data breach?" check at sign-up (tests turn it off).
PASSWORD_LEAK_CHECK=

# trace | debug | info | warn | error | silent (default info)
LOG_LEVEL=info

# Disposable database for `npm test`. Wiped on every run; name must contain "test".
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5544/madebyjimbob_test

# Web Push (phone notifications). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The private key is secret. Without these, push is off and the in-site bell still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://madebyjimbob.onrender.com

# Search engines: leave unset (noindex) until the real domain is live, then set true and SITE_URL.
ALLOW_INDEXING=
SITE_URL=

# JimBob's Shopify store for the Shop and Art pages (default https://madebyjimbob.com; tests use a stub).
SHOP_URL=

# Account email via Resend (ADR-012). Without RESEND_API_KEY and EMAIL_FROM, email is off (nothing sent).
# EMAIL_FROM must be on a domain verified in Resend, e.g. MADEbyJIMBOB <hello@madebyjimbob.com>.
# EMAIL_REPLY_TO: where replies go (a real inbox). RESEND_WEBHOOK_SECRET: from the Resend webhook (whsec_...).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Optional (MBJ-706): a free YouTube Data API key makes Studio's channel list load instantly. Without it, the
# import helper on your PC lists the channel. Google Cloud Console → APIs & Services → YouTube Data API v3.
YOUTUBE_API_KEY=

# Owned live (ADR-004): the Owncast server OBS streams to. Local test: Docker on this PC
# (docker run ... -p 127.0.0.1:8080:8080 -p 127.0.0.1:1935:1935 owncast/owncast). Leave empty to hide Studio → Live.
OWNCAST_URL=
OWNCAST_RTMP_URL=rtmp://localhost:1935/live
OWNCAST_STREAM_KEY=
# Go Live from Studio: a Hetzner Cloud token (project MadeByJimBob → Security → API tokens, Read & Write).
# Leave OWNCAST_URL empty to use it. Optional: LIVE_SERVER_TYPE (cpx31), LIVE_LOCATION (ash), LIVE_HOURLY_USD (0.118).
HETZNER_API_TOKEN=
