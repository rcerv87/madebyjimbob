# Render gives you DATABASE_URL. For local imports, use the database's *External* URL and PGSSL=true.
DATABASE_URL=postgres://user:pass@host:5432/madebyjimbob
PGSSL=true

# Cloudflare: Account ID (dashboard sidebar), API token with "Stream: Edit",
# and the customer code from any Stream video URL: customer-<CODE>.cloudflarestream.com
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_STREAM_CUSTOMER_CODE=

# Comma-separated words masked in chat
BANNED_WORDS=

# Comma-separated usernames that can open Studio (and watch every tier)
ADMIN_USERNAMES=jimbob

# true = sign-in shows a tier picker for testing. Keep false in production.
ALLOW_TEST_TIERS=false

# Disposable database for `npm test`. Wiped on every run; name must contain "test".
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5544/madebyjimbob_test
