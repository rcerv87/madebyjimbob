# Render gives you DATABASE_URL. For local imports, use the database's *External* URL and PGSSL=true.
DATABASE_URL=postgres://user:pass@host:5432/madebyjimbob
PGSSL=true

# Cloudflare: Account ID (dashboard sidebar), API token with "Stream: Edit",
# and the customer code from any Stream video URL: customer-<CODE>.cloudflarestream.com
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_STREAM_CUSTOMER_CODE=

# Comma-separated words masked in chat
BANNED_WORDS=

# Comma-separated usernames that can open Studio (and watch every tier)
ADMIN_USERNAMES=jimbob

# true = sign-in shows a tier picker for testing. Keep false in production.
ALLOW_TEST_TIERS=false

# trace | debug | info | warn | error | silent (default info)
LOG_LEVEL=info

# Disposable database for `npm test`. Wiped on every run; name must contain "test".
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5544/madebyjimbob_test

# Web Push (phone notifications). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The private key is secret. Without these, push is off and the in-site bell still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://madebyjimbob.onrender.com

# Search engines: leave unset (noindex) until the real domain is live, then set true and SITE_URL.
ALLOW_INDEXING=
SITE_URL=

# JimBob's Shopify store for the Shop and Art pages (default https://madebyjimbob.com; tests use a stub).
SHOP_URL=

# Account email via Resend (ADR-012). Without RESEND_API_KEY and EMAIL_FROM, email is off (nothing sent).
# EMAIL_FROM must be on a domain verified in Resend, e.g. MADEbyJIMBOB <hello@madebyjimbob.com>.
# EMAIL_REPLY_TO: where replies go (a real inbox). RESEND_WEBHOOK_SECRET: from the Resend webhook (whsec_...).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=
