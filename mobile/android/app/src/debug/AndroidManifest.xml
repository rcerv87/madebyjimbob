<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a test build may talk to the PC's own server over plain http (through adb reverse).
     Store builds (release) keep Android's default: https only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
