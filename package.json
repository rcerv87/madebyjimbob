{
  "name": "madebyjimbob",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w web",
    "start": "npm start -w server",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "import:youtube": "npm run import -w server --",
    "test": "npm test -w server && npm test -w web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "npm run migrate -w server --",
    "migrate:create": "npm run migrate:create -w server --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "type": "module"
}
