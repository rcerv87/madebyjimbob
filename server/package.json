{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "npm run migrate && node --watch src/index.js",
    "import": "node scripts/import-youtube.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "captions:fetch": "node scripts/fetch-captions.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "tus-js-client": "^4.2.3",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  }
}
